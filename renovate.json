{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>damoun/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.version$/"
      ],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "protonpass/pass-cli",
      "datasourceTemplate": "github-tags"
    }
  ]
}
