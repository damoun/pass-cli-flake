{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>damoun/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.version$"],
      "matchStrings": ["(?<currentValue>.*)"],
      "depNameTemplate": "protonpass/pass-cli",
      "datasourceTemplate": "github-tags"
    }
  ]
}
